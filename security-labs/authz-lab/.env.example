# Copy to .env — never commit the real .env

DATABASE_URL=postgres://authz_lab:authz_lab_dev_only@127.0.0.1:5432/authz_lab
JWT_SECRET=dev_only_change_me_do_not_reuse
PORT=3000

# Master switch: when true, every intentional flaw below is force-disabled
# regardless of its individual setting.
SECURE_MODE=false

# Per-flaw toggles (ignored when SECURE_MODE=true)
FLAW_IDOR=true
FLAW_VERTICAL_ESCALATION=true
FLAW_CROSS_TENANT=true
FLAW_ALT_METHODS=true
FLAW_HIDDEN_ENDPOINT=true
FLAW_WORKFLOW_SKIP=true
FLAW_STALE_INVITE=true
FLAW_ROLE_DOWNGRADE_PERSISTENCE=true
FLAW_RACE_CONDITION=true
FLAW_MASS_ASSIGNMENT=true
FLAW_GRAPHQL_FIELD_AUTHZ=true
FLAW_FILE_OBJECT_MISMATCH=true
FLAW_DEPRECATED_API_GAP=true
